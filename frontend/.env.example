# ==============================================================================
# Enterprise Knowledge & Task Assistant - Frontend Configuration Template
# Copy this file to .env in this directory and adjust the values for your environment.
# Note: Vite exposes only variables prefixed with VITE_ to the client browser bundle.
# ==============================================================================

# Backend API Base URL
# Default points directly to the FastAPI server. If proxying through Vite dev server, use "/api/v1".
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Authentication Mode
# Set to 'true' to use local mock authentication without Microsoft Entra ID login
VITE_MOCK_AUTH=true

# Microsoft Entra ID (MSAL) Client Configuration
# Required when VITE_MOCK_AUTH is set to 'false'
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# Application Branding
VITE_APP_TITLE="Enterprise Knowledge & Task Assistant"
