# ==============================================================================
# Enterprise Knowledge & Task Assistant - Environment Configuration Template
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 2. Microsoft Entra ID (Authentication & Authorization)
# ------------------------------------------------------------------------------
# Set MOCK_AUTH_ENABLED=true for local development without active Entra ID tenant
MOCK_AUTH_ENABLED=true
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 3. Azure OpenAI / Microsoft Foundry
# ------------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ------------------------------------------------------------------------------
# 4. Azure AI Search
# ------------------------------------------------------------------------------
AZURE_SEARCH_SERVICE_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=corporate-knowledge-index
AZURE_SEARCH_USE_SEMANTIC_RANKER=true

# ------------------------------------------------------------------------------
# 5. Azure Blob Storage (Document Storage)
# ------------------------------------------------------------------------------
AZURE_STORAGE_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net
AZURE_STORAGE_CONTAINER_NAME=corporate-documents
AZURE_STORAGE_CONNECTION_STRING=

# ------------------------------------------------------------------------------
# 6. Database (PostgreSQL persistence)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_agent

# ------------------------------------------------------------------------------
# 7. Internal Business APIs & Integrations (HR / IT / Finance)
# ------------------------------------------------------------------------------
USE_MOCK_INTERNAL_SERVICES=true
HR_SERVICE_URL=http://localhost:8001/hr
IT_SERVICE_URL=http://localhost:8001/it
FINANCE_SERVICE_URL=http://localhost:8001/finance

# ------------------------------------------------------------------------------
# 8. Frontend Vite Environment Variables (client-facing)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MOCK_AUTH=true
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_REDIRECT_URI=http://localhost:5173
