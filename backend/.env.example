# ==============================================================================
# Enterprise Knowledge & Task Assistant - Backend Configuration Template
# Copy this file to .env in this directory (or project root) and adjust values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
APP_NAME="Enterprise Knowledge & Task Assistant"
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
# JSON array or comma-separated list of allowed CORS origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# ------------------------------------------------------------------------------
# 2. Microsoft Entra ID (Authentication & Authorization)
# ------------------------------------------------------------------------------
# Set MOCK_AUTH_ENABLED=true for local development without an active Entra ID tenant
MOCK_AUTH_ENABLED=true
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 3. Azure OpenAI / Microsoft Foundry
# ------------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ------------------------------------------------------------------------------
# 4. Azure AI Search
# ------------------------------------------------------------------------------
AZURE_SEARCH_SERVICE_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=corporate-knowledge-index
AZURE_SEARCH_USE_SEMANTIC_RANKER=true

# ------------------------------------------------------------------------------
# 5. Azure Blob Storage (Document Storage)
# ------------------------------------------------------------------------------
AZURE_STORAGE_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net
AZURE_STORAGE_CONTAINER_NAME=corporate-documents
AZURE_STORAGE_CONNECTION_STRING=

# ------------------------------------------------------------------------------
# 6. Database (PostgreSQL Persistence)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_agent

# ------------------------------------------------------------------------------
# 7. Internal Business APIs & Integrations (HR / IT / Finance)
# ------------------------------------------------------------------------------
# Set USE_MOCK_INTERNAL_SERVICES=true to use deterministic in-memory mock services
USE_MOCK_INTERNAL_SERVICES=true
HR_SERVICE_URL=http://localhost:8001/hr
IT_SERVICE_URL=http://localhost:8001/it
FINANCE_SERVICE_URL=http://localhost:8001/finance
